# Wedding Pola build settings. Copy to .env.wedpola.local (never commit that) or set these in
# the Netlify site's environment. Values are public in the built site, so only use the
# publishable key here. Never put a service-role key in this file or in the repo.

# Your Supabase project URL, for example https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key of that project (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The wed-idea studio site that receives the photos, for example https://your-studio.example
# (no trailing slash). The same value is set as PIXI_STUDIO_ORIGIN on the wed-idea site.
NEXT_PUBLIC_STUDIO_SITE=
